# Copy to /opt/tutumuch/.env on the server. Never commit the real file.
IMAGE_PREFIX=ghcr.io/quinntynebrown
IMAGE_TAG=latest
SITE_ADDRESS=tutumuch.kids, www.tutumuch.kids

ConnectionStrings__TuTuMuch=Server=tcp:<server>.database.windows.net,1433;Database=TuTuMuch;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30
Auth__SigningKey=<64 random characters>
Notifications__UnsubscribeSigningKey=<64 random characters>
App__BaseUrl=https://tutumuch.kids
