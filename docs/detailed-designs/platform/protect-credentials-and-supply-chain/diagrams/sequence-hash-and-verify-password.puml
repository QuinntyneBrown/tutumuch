@startuml
title UML sequence behaviour — Hash and verify a password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Tutu Much Web application" #E0F2FE
  participant "Sign-in page" as page
  participant "AccountsApiService" as client
end box
box "Backend — Tutu Much API application" #D1FADF
  participant "AuthController" as ctrl
end box
box "Backend — Tutu Much Application and Domain" #ECFDF3
  participant "SignInCommandHandler" as handler
  participant "Member" as member
end box
box "Backend — Tutu Much Infrastructure" #FFF4E5
  participant "Pbkdf2PasswordHasher" as hasher
  database "Tutu Much database" as db
end box
actor -> page : Enter email and password
page -> client : signIn(email, password)
client -> ctrl : POST /api/auth/sign-in
ctrl -> handler : Send SignInCommand
handler -> db : Load Member by email
db --> handler : Member with PasswordHash
handler -> hasher : Verify(password, encoded)
hasher -> hasher : Parse pbkdf2-sha512$iterations$salt$key
hasher -> hasher : PBKDF2-HMAC-SHA512 with stored salt and iterations (L2-052)
hasher -> hasher : FixedTimeEquals(derived, stored)
alt Keys differ
  hasher --> handler : Failed
  handler --> ctrl : Sign-in failure (accounts rules, L2-007)
else Keys match and stored iterations < configured
  hasher --> handler : SucceededNeedsRehash
  handler -> hasher : Hash(password) with new 16-byte salt
  hasher --> handler : New encoded hash
  handler -> member : ChangePasswordHash(encoded)
  handler -> db : Save in one unit of work
  db --> handler : Committed
  handler --> ctrl : Signed in
else Keys match
  hasher --> handler : Succeeded
  handler --> ctrl : Signed in
end
ctrl --> client : 200 with session cookies, or problem details
client --> page : Result
page --> actor : Continue or show error
@enduml
