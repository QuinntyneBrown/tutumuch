@startuml
title UML sequence behaviour — Load secrets at start
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "Container runtime" as runtime
box "Backend — TuTuMuch API application" #D1FADF
  participant "Program (host builder)" as host
  participant "SecretGuard" as guard
  participant "Readiness endpoint" as ready
end box
box "Backend — TuTuMuch Infrastructure" #FFF4E5
  participant "AddTuTuMuchSecretStore" as provider
end box
participant "Secret store (vault)" as vault
runtime -> host : Start container with SecretStore__Uri
host -> provider : Add secret store provider
provider -> vault : Authenticate with workload identity
alt Identity rejected or vault unreachable
  vault --> provider : Error
  provider --> host : Configuration build fails
  host --> runtime : Exit non-zero; deployment rolls back
else Authenticated
  vault --> provider : Secrets (connection strings, API keys, signing keys)
  provider --> host : Configuration root
  host -> guard : StartAsync
  guard -> guard : For each SecretKeys entry find supplying provider (L2-052)
  alt Missing, or supplied by appsettings JSON or command line
    guard -> guard : Log secret_source_invalid with key name only
    guard --> host : Stop application
    host --> runtime : Exit non-zero
  else All supplied by the secret store
    guard --> host : Started
    host -> ready : Begin serving /health/ready
    ready --> runtime : 200 when dependencies reachable
  end
end
@enduml
