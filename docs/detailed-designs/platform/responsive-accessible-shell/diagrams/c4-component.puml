@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Responsive, accessible application shell

Container_Boundary(web, "Tutu Much Web") {
  Component(app, "AppComponent", "Root component", "Skip link, shell by route data, toast region")
  Component(shells, "AppShell / AuthShell / AdminShell / BareShell", "Shell components", "Frame each page around main#main")
  Component(topbar, "TopbarComponent + AdminTopbarComponent", "Components", "Menu button, primary nav, search, account")
  Component(footer, "FooterComponent + AccountSubnavComponent", "Components", "Footer links; account tabs")
  Component(menu, "NavMenuSheetComponent", "Sheet", "Full-screen menu below 768 px")
  Component(bp, "BreakpointService", "Service", "xs, sm, md, lg, xl signals")
  Component(sheet, "SheetService", "Service", "Full and side sheets with focus trap")
  Component(dialog, "DialogService", "Service", "CDK Dialog; trap, Escape, restore focus")
  Component(routefocus, "RouteFocusService", "Service", "Focus h1 and announce page on navigation")
  Component(forms, "FormFieldComponent + FormErrorsDirective + ErrorSummaryComponent", "Components", "Labels, error summary, focus first invalid")
  Component(live, "LiveRegionService", "Service", "Polite and assertive announcements")
  Component(toast, "ToastService + ToastRegionComponent", "Service and component", "Toasts; danger never auto-dismisses")
  Component(banner, "SystemBannerService + SystemBannerComponent", "Service and component", "Offline and maintenance banners")
  Component(features, "Feature pages", "Components", "Catalog, listings, orders, ...")
}
Rel(app, shells, "Renders")
Rel(shells, topbar, "Contains")
Rel(shells, footer, "Contains")
Rel(shells, banner, "Shows banners from")
Rel(topbar, sheet, "Opens menu through")
Rel(sheet, menu, "Hosts")
Rel(topbar, bp, "Reads breakpoint")
Rel(features, sheet, "Opens filters through")
Rel(features, dialog, "Opens dialogs through")
Rel(features, forms, "Use")
Rel(forms, live, "Announces errors")
Rel(routefocus, live, "Announces page")
Rel(toast, live, "Uses region roles")
@enduml
