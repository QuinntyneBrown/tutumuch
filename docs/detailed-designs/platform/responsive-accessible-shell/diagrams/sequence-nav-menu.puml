@startuml
title UML sequence behaviour — Open and close the navigation menu
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Keyboard user on a phone" as actor
box "Frontend — Tutu Much Web application" #E0F2FE
  participant "TopbarComponent" as topbar
  participant "BreakpointService" as bp
  participant "SheetService (CDK overlay + FocusTrap)" as sheet
  participant "NavMenuSheetComponent" as menu
  participant "Router" as router
end box
topbar -> bp : breakpoint()
bp --> topbar : xs (below 768 px): show menu button (L2-062)
actor -> topbar : Activate "Open menu"
topbar -> sheet : open(NavMenuSheetComponent, full)
sheet -> menu : Create with role=dialog, aria-modal
sheet -> sheet : Set aria-expanded=true, make background inert
sheet -> menu : Focus "Close menu" (L2-065)
actor -> menu : Press Tab repeatedly
menu -> sheet : Focus wraps inside the sheet (L2-065)
alt Escape or "Close menu"
  actor -> menu : Press Escape
  menu -> sheet : close()
  sheet -> topbar : Restore focus to "Open menu"; aria-expanded=false
else Choose a link
  actor -> menu : Activate "Shoes"
  menu -> router : navigate
  router -> sheet : NavigationStart closes sheet
  sheet -> sheet : Focus moves via RouteFocusService to page h1
end
@enduml
