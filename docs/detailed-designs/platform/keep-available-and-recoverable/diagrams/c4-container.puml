@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Keep TuTuMuch available and recoverable

Person(visitor, "Visitor or member", "Browser")
System_Boundary(tutumuch, "TuTuMuch") {
  Container(lb, "Load balancer", "Hosting platform <TO SUPPLY>", "Probes /health/ready every 10 s; serves static maintenance page")
  Container(web, "TuTuMuch Web", "Angular", "Maintenance banner and page")
  Container(api, "TuTuMuch API (3+ instances)", "ASP.NET Core", "System status, maintenance mode, graceful shutdown")
  Container(worker, "TuTuMuch Worker (2+ instances)", ".NET worker", "Background jobs")
  ContainerDb(db, "TuTuMuch database", "Managed SQL Server", "PITR, 35-day retention")
  ContainerDb(restored, "Restored copy", "Managed SQL Server", "Temporary database for the restore test")
  Container(verifier, "TuTuMuch.RestoreVerifier", ".NET console", "Checks restored data")
}
Rel(visitor, lb, "Requests", "HTTPS")
Rel(lb, web, "Routes pages", "HTTPS")
Rel(lb, api, "Routes API; probes readiness", "HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(worker, db, "Reads and writes", "EF Core")
Rel(db, restored, "Restored to point in time")
Rel(verifier, restored, "Verifies", "SQL")
@enduml
