@startuml
title UML sequence behaviour — Reset the local install (L2-072, L2-073)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Developer" as dev
box "TutuMuch.Cli" #FFF4E5
  participant "CliApp" as cli
  participant "ResetGuard" as guard
  participant "DemoReset" as reset
end box
box "Infrastructure" #D1FADF
  participant "MigratedSchema" as schema
  participant "MigratorApp" as mig
  participant "Photo store folder" as store
end box
database "Tutu Much database" as sql
dev -> cli : reset [--force]
alt ConnectionStrings__TutuMuch not set
  cli --> dev : "Set ConnectionStrings__TutuMuch ..." exit 2 (L2-077)
else connection string set
  cli -> guard : environment, --force, connection string
  guard --> dev : "Target: server (localdb)\\MSSQLLocalDB, database TutuMuch"
  alt not Development and no --force
    guard --> dev : "reset only runs in Development or with --force" exit 3 (L2-073)
  else allowed
    cli -> reset : Run
    reset -> schema : Rebuild(db)
    schema -> sql : EnsureDeleted (DROP DATABASE)
    schema -> mig : ApplyMigrations(db)
    mig -> sql : Migrate() — every migration
    alt database unreachable or migration fails
      sql --> cli : exception
      cli --> dev : "Reset failed: ..." exit 5
    else ok
      reset -> store : delete public/ and private/ under RootPath
      reset --> dev : "Database dropped. Migrations applied. Photo store emptied." exit 0 (L2-072)
    end
  end
end
@enduml
