@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Seed demo data (TuTuMuch.Cli)

Person(dev, "Developer", "Runs reset and seed on their own machine")
System_Boundary(cli, "TuTuMuch.Cli (src/backend/TuTuMuch.Cli)") {
  Component(program, "Program / CliApp", "Console entry point", "Reads configuration and DOTNET_ENVIRONMENT, parses arguments, maps failures to exit codes")
  Component(args, "CliArguments", "Plain argument parsing", "help | reset [~--force] | seed [~--reset] [~--force]")
  Component(guard, "ResetGuard", "Safety check", "Development or ~--force; prints server and database, never credentials")
  Component(reset, "DemoReset", "Command", "Drops and rebuilds the schema, empties the photo store")
  Component(schema, "IDatabaseSchema", "Port", "MigratedSchema: EnsureDeleted + MigratorApp.ApplyMigrations")
  Component(seeder, "DemoSeeder", "Command", "Registers, verifies, uploads, drafts and publishes through MediatR")
  Component(catalogue, "DemoCatalogue", "Static data", "8 members, 48 listings, photo file names per listing")
  Component(clock, "SeedClock", "TimeProvider", "Moved back in time per listing so publishes spread over 30 days")
  Component(photos, "SeedPhotos/{category}/", "24 JPEG files + ATTRIBUTION.md", "CC BY 2.0, copied to the output folder")
}
System_Boundary(app, "TuTuMuch.Application + TuTuMuch.Domain") {
  Component(cmds, "MediatR handlers", "Commands", "RegisterMember, VerifyEmail, UploadListingPhoto, CreateListingDraft, PublishListing")
  Component(domain, "Member, Listing, ListingPhoto, OutboxMessage", "Domain", "Size lock, category, publish and photo rules")
}
System_Boundary(infra, "TuTuMuch.Infrastructure + TuTuMuch.Migrator") {
  Component(db, "TuTuMuchDbContext", "EF Core SQL Server", "ConnectionStrings__TuTuMuch")
  Component(pipeline, "SkiaPhotoProcessor + SkiaImageInspector", "SkiaSharp", "Strips metadata, WebP + JPEG at 400/800/1600")
  Component(store, "FileSystemPhotoStorage", "IPhotoStorage", "PhotoStorage:RootPath (public/, private/)")
  Component(migrator, "MigratorApp.ApplyMigrations", "Shared migration code", "Also used by TuTuMuch.Migrator")
}
ContainerDb(sql, "TuTuMuch database", "SQL Server / LocalDB")
Rel(dev, program, "dotnet TuTuMuch.Cli.dll seed --reset")
Rel(program, args, "Parses")
Rel(program, guard, "Before reset")
Rel(program, reset, "reset")
Rel(program, seeder, "seed")
Rel(reset, schema, "Rebuild")
Rel(schema, migrator, "Applies every migration")
Rel(reset, store, "Deletes RootPath contents")
Rel(seeder, catalogue, "Reads")
Rel(seeder, photos, "Reads bytes")
Rel(seeder, clock, "Sets time per step")
Rel(seeder, cmds, "ISender.Send")
Rel(cmds, domain, "Applies rules")
Rel(cmds, pipeline, "Uploads")
Rel(cmds, store, "Saves versions and originals")
Rel(cmds, db, "SaveChanges")
Rel(migrator, db, "Migrate()")
Rel(db, sql, "SQL")
@enduml
