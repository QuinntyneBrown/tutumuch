@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Marketing page (/welcome)

Person(visitor, "Visitor or member", "Shopper or seller deciding whether TuTuMuch is for them")
System_Boundary(app, "tutumuch application (projects/tutumuch)") {
  Component(routes, "app.routes.ts", "Angular router", "Lazy-loads @tutumuch/marketing at welcome")
  Component(shell, "AppShellComponent", "Shell", "data.shell 'marketing': top bar, main.marketing without container, footer")
  Component(media, "public/media/", "Static files", "tutumuch-pitch.mp4/.webm/.vtt/.txt, poster PNG, ATTRIBUTION.md")
  Component(items, "public/items/", "Static files", "Item illustrations for the closet-worth chips")
}
System_Boundary(mkt, "@tutumuch/marketing") {
  Component(page, "WelcomePage", "Standalone component", "Copy, CTA targets from AuthState, the Phase 1 choice from LaunchState")
  Component(dialog, "PitchVideoDialog", "Dialog content", "tl-dialog + tl-video-player")
}
System_Boundary(cmp, "@tutumuch/components") {
  Component(hero, "tl-marketing-hero + tl-tulle-field", "Components", "Solid blush showcase band; Phase 1 tulle canvas in the backdrop slot")
  Component(phase1, "tl-closet-marquee + tl-closet-worth", "Components", "Phase 1: listings gliding past; typical total of outgrown items")
  Component(band, "tl-feature-band + tl-steps", "Components", "Shopper, seller and how-it-works bands; journey steps in Phase 1")
  Component(poster, "tl-video-poster", "Component", "Poster as a play button; nothing autoplays")
  Component(player, "tl-video-player", "Component", "Sources, captions toggle (off by default), loading and error")
  Component(dlg, "DialogService", "Service", "Modal, Escape, focus return")
  Component(footer, "tl-footer", "Component", "About TuTuMuch link to /welcome")
}
System_Boundary(api, "@tutumuch/api") {
  Component(auth, "AuthState", "Signal store", "member(): null for a visitor")
  Component(launch, "LaunchState", "Signal store", "phase(), canSell()")
  Component(catalog, "CatalogApi", "HTTP client", "listings(1): the newest listings")
}
System_Ext(build, "docs/mocks/_build/video/build_video.py", "Kokoro-82M voice, Pixabay ukulele music, Playwright slides, ffmpeg")

Rel(visitor, routes, "Opens /welcome or follows About TuTuMuch")
Rel(routes, page, "loadChildren")
Rel(shell, footer, "Renders")
Rel(page, hero, "Composes")
Rel(page, band, "Composes")
Rel(page, poster, "Media slot")
Rel(page, auth, "Reads member()")
Rel(page, launch, "Reads phase() and canSell()")
Rel(page, phase1, "Composes in Phase 1")
Rel(page, catalog, "Phase 1: GET /api/catalog/listings once")
Rel(phase1, items, "GET /items/*.svg")
Rel(poster, dlg, "watch → open(PitchVideoDialog)")
Rel(dlg, dialog, "Creates")
Rel(dialog, player, "Composes")
Rel(player, media, "GET /media/tutumuch-pitch.*")
Rel(build, media, "Writes")
@enduml
