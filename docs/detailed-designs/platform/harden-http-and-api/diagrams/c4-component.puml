@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Harden HTTP and the API

Container(web, "Tutu Much Web", "Angular", "AntiforgeryInterceptor, RateLimitInterceptor")
Container_Boundary(api, "Tutu Much API") {
  Component(fwd, "ForwardedHeaders + HttpsRedirection + Hsts", "ASP.NET Core middleware", "Trusted client IP, 301 to HTTPS, HSTS one year")
  Component(headers, "SecurityHeadersMiddleware", "Middleware", "CSP, nosniff, Referrer-Policy; strips Server")
  Component(cors, "CORS policy Frontend", "Middleware", "Allows only Cors:AllowedOrigins")
  Component(rl, "RedisRateLimitingMiddleware", "Middleware", "Applies RateLimitPolicies; 429 + Retry-After")
  Component(af, "AntiforgeryValidationMiddleware", "Middleware", "Validates X-XSRF-TOKEN on writes; 400 antiforgery_invalid")
  Component(afctrl, "AntiforgeryController", "Controller", "GET /api/antiforgery/token")
  Component(ctrl, "Feature controllers", "Controllers", "Bind dedicated request records only")
  Component(vb, "ValidationBehavior", "MediatR pipeline behaviour", "Runs FluentValidation validators")
  Component(handler, "Feature handlers", "MediatR handlers", "Business logic of each feature")
  Component(store, "RedisFixedWindowRateLimitStore", "IRateLimitStore", "Atomic INCR + EXPIRE Lua script")
  Component(ef, "TutuMuchDbContext", "EF Core", "Parameterised SQL; raw SQL APIs banned")
}
ContainerDb(cache, "Distributed cache", "Redis", "Rate-limit counters")
ContainerDb(db, "Tutu Much database", "SQL Server", "Business data")

Rel(web, fwd, "Sends requests", "HTTPS")
Rel(fwd, headers, "Passes request")
Rel(headers, cors, "Passes request")
Rel(cors, rl, "Passes request")
Rel(rl, store, "Acquires lease")
Rel(store, cache, "EVAL script", "RESP")
Rel(rl, af, "Passes request")
Rel(af, afctrl, "Passes token request")
Rel(af, ctrl, "Passes validated write")
Rel(ctrl, vb, "Sends command or query")
Rel(vb, handler, "Invokes when valid")
Rel(handler, ef, "Queries and saves")
Rel(ef, db, "Parameterised SQL", "TDS")
@enduml
