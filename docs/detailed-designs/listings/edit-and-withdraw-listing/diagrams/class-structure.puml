@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Edit and withdraw a listing

package "TuTuMuch.Domain" {
  enum ListingStatus {
    Draft
    Active
    Reserved
    Sold
    Removed
  }
  enum ListingRemovalReason {
    OrderCancelled
    Withdrawn
  }
  class Listing {
    +Guid Id
    +string Reference
    +Guid SellerId
    +ListingStatus Status
    +ListingRemovalReason? RemovalReason
    +string Category
    +string Size
    +decimal? Price
    +int Version
    +string? EditRefusal
    +bool CanRelist
    +UpdateDetails(details, now): void
    +Edit(details, sizeConfirmed, photoCount, now): RuleViolation[]
    +Withdraw(now): void
    +RemoveAfterCancellation(now): void
    +Relist(now): void
    +{static} CheckPublish(details, sizeConfirmed, photoCount): RuleViolation[]
  }
}

package "TuTuMuch.Application" {
  class GetMyListingQuery {
    +string Reference
  }
  class MyListingDto {
    +string Reference
    +string Status
    +string? RemovalReason
    +PhotoDto[] Photos
    +int Version (JSON ignored, sent as ETag)
  }
  class UpdateListingCommand {
    +string Reference
    +ListingDetails Details
    +Guid[]? PhotoIds
    +bool SizeConfirmed
    +int? ExpectedVersion
  }
  class WithdrawListingCommand {
    +string Reference
  }
  class RelistListingCommand {
    +string Reference
  }
  class ListingCommandHandlers {
    +Handle(UpdateListingCommand): Result<MyListingDto>
    +Handle(GetMyListingQuery): Result<MyListingDto>
  }
  class WithdrawListingCommandHandler {
    +Handle(command): Result<WithdrawListingResult>
  }
  class RelistListingCommandHandler {
    +Handle(command): Result<bool>
  }
  class ListingRefusals {
    +Reserved, Sold, NotEditable, Changed, PreconditionRequired
    +AfterConflictAsync(db, listingId): Error
  }
  class ListingPhotoAttacher
}

package "TuTuMuch.Api" {
  class ListingsController {
    +GetMine(reference): IActionResult
    +Update(reference, body): IActionResult
    +Withdraw(reference): IActionResult
    +Relist(reference): IActionResult
  }
  class ListingDetailsRequest {
    +string? Category
    +string? Subcategory
    +string? Size
    +string? Title
    +string? Description
    +string? Brand
    +string? Condition
    +string? Flaws
    +decimal? Price
    +decimal? ShippingCost
    +Guid[]? PhotoIds
    +bool? SizeConfirmed
  }
}

ListingsController ..> ListingDetailsRequest : binds (no sellerId or status)
ListingsController ..> UpdateListingCommand : sends (If-Match as ExpectedVersion)
ListingsController ..> WithdrawListingCommand : sends
ListingsController ..> RelistListingCommand : sends
ListingCommandHandlers ..> UpdateListingCommand : handles
ListingCommandHandlers ..> GetMyListingQuery : handles
ListingCommandHandlers --> Listing : loads / edits
ListingCommandHandlers ..> ListingPhotoAttacher : uses
ListingCommandHandlers ..> ListingRefusals : refuses with
WithdrawListingCommandHandler --> Listing : withdraws
WithdrawListingCommandHandler ..> ListingRefusals : refuses with
RelistListingCommandHandler --> Listing : relists
Listing --> ListingStatus
Listing --> ListingRemovalReason
ListingCommandHandlers ..> MyListingDto : returns
@enduml
