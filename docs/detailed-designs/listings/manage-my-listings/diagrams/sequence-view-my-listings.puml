@startuml
title UML sequence behaviour — View and filter my listings
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Seller" as actor
box "Frontend — TuTuMuch Web application" #E0F2FE
  participant "MyListingsPage (@tutumuch/listings)" as page
  participant "ListingsApi (@tutumuch/api)" as client
end box
box "Backend — TuTuMuch API application" #D1FADF
  participant "ListingsController" as controller
end box
box "Backend — TuTuMuch Application and Domain" #ECFDF3
  participant "GetMyListingsQueryHandler" as handler
end box
box "Backend — TuTuMuch Infrastructure" #FFF4E5
  database "TuTuMuch database" as db
end box
actor -> page : Open /account/listings (optionally ?status=sold)
page --> actor : Loading state: skeleton rows
page -> client : mine(status)
client -> controller : GET /api/me/listings?status=Sold
controller -> controller : Verified member (401 if anonymous)
controller -> handler : Send GetMyListingsQuery(sellerId from token)
handler -> db : SELECT seller's listings by status ORDER BY CreatedAt DESC, Id DESC (L2-021)
handler -> db : SELECT COUNT per status for chips
alt database or network failure
  db --> handler : Error
  controller --> client : 500 problem details with correlation ID
  client --> page : Error state "Couldn't load your listings" with Ref and "Try again"
else rows returned
  db --> handler : Rows with cover version and sale order ID
  handler --> controller : MyListingsDto
  controller --> client : 200
  alt seller has no listings
    client --> page : Empty state "Nothing listed yet" with "Sell an item"
  else listings exist
    client --> page : Rows: cover, title, status, price, date; chips with counts
    page --> actor : Filter chip "Sold" pressed; only Sold rows shown
  end
end
actor -> page : Select a row
alt Draft
  page --> actor : Navigate to /sell/{reference}
else Sold
  page --> actor : Navigate to /sales/{saleOrderId}
else Active, Reserved or Removed
  page --> actor : Navigate to /items/{reference}
end
@enduml
