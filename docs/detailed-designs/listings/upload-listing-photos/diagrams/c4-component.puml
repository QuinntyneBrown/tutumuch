@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Upload listing photos

Container(web, "TuTuMuch Web", "Angular", "SellPage, tl-photo-uploader, PhotosApi, ListingsApi")
Container_Boundary(api, "TuTuMuch API") {
  Component(ctrl, "PhotoUploadsController", "ASP.NET Core controller", "POST /api/photo-uploads, GET /api/photo-uploads/{id}")
  Component(photos, "PhotosController", "ASP.NET Core controller", "GET /photos/{hash}/{file}, one-year immutable cache")
  Component(listings, "ListingsController", "ASP.NET Core controller", "POST and PUT /api/listings with photoIds")
  Component(handler, "ListingPhotoHandlers", "MediatR handlers", "Checks size, type, shortest side, pixels; processes and stores")
  Component(attach, "ListingPhotoAttacher", "Application service", "Attaches up to 8 owned photos in order on listing save")
  Component(inspector, "SkiaImageInspector", "IImageInspector", "Magic bytes and header dimensions")
  Component(proc, "SkiaPhotoProcessor", "IListingPhotoProcessor", "Orients, strips metadata, re-encodes 400, 800, 1600 px in WebP and JPEG")
  Component(store, "FileSystemPhotoStorage", "IPhotoStorage", "private/ originals, public/ versions")
}
ComponentDb(db, "TuTuMuch database", "SQL Server", "ListingPhotos, ListingPhotoVersions")

Rel(web, ctrl, "Uploads one file per request", "multipart/form-data")
Rel(web, listings, "Saves photoIds in display order", "JSON")
Rel(web, photos, "Loads thumbnails")
Rel(ctrl, handler, "Sends UploadListingPhotoCommand")
Rel(handler, inspector, "Inspects bytes")
Rel(handler, proc, "Processes original")
Rel(handler, store, "Writes versions and original")
Rel(handler, db, "Inserts photo row")
Rel(listings, attach, "Via the listing command handlers")
Rel(attach, db, "Sets ListingId and Position")
Rel(photos, store, "Reads version")
@enduml
