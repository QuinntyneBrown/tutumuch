@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Create a listing

Person(seller, "Seller", "Lists an item for sale")
System_Boundary(tutumuch, "TuTuMuch") {
  Container(web, "TuTuMuch Web", "Angular", "SellPage in @tutumuch/listings; SellingApi, ListingsApi and AuthState in @tutumuch/api")
  Container(api, "TuTuMuch API", "ASP.NET Core", "Categories, selling options, listing create, update and publish")
  ContainerDb(db, "TuTuMuch database", "SQL Server", "Members, sessions, listings; the day's publishes are counted here")
}
Rel(seller, web, "Uses", "HTTPS")
Rel(web, api, "Calls with session cookies", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
