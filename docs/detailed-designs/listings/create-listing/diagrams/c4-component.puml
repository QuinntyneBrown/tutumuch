@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Create a listing

Container(web, "Tutu Much Web", "Angular", "SellPage, VerifyEmailPromptComponent, SellingApi, ListingsApi")
Container_Boundary(api, "Tutu Much API") {
  Component(catCtrl, "CategoriesController", "ASP.NET Core controller", "GET /api/categories, GET /api/selling/options")
  Component(ctrl, "ListingsController", "ASP.NET Core controller", "POST /api/listings, PUT /api/listings/{reference}, POST /api/listings/{reference}/publish, GET /api/me/listings/{reference}")
  Component(policy, "CanSell policy", "ASP.NET Core authorization", "401 for visitors, 403 EMAIL_NOT_VERIFIED for unverified members")
  Component(handlers, "ListingCommandHandlers", "MediatR handlers", "Create, update, publish and read the caller's listing; daily publish limit")
  Component(rules, "CategoryCatalog", "Domain", "Accepted categories, subcategories and sizes (L2-011)")
  Component(entity, "Listing", "Domain aggregate", "Server-set size, draft and publish rules, status transitions")
  Component(payout, "ISellerPayoutAccountReader", "Application port", "Reports whether payout onboarding is complete")
  ComponentDb(db, "TutuMuchDbContext", "EF Core", "Members and Listings tables")
}

Rel(web, catCtrl, "Loads categories and options", "JSON/HTTPS")
Rel(web, ctrl, "Saves and publishes", "JSON/HTTPS")
Rel(catCtrl, rules, "Reads")
Rel(ctrl, policy, "Authorizes through")
Rel(policy, db, "Reads EmailVerifiedAt")
Rel(ctrl, handlers, "Sends commands")
Rel(handlers, db, "Counts today's publishes; persists in one unit of work")
Rel(handlers, entity, "Creates, checks and publishes")
Rel(entity, rules, "Resolves size from category")
Rel(handlers, payout, "Checks onboarding after publish")
@enduml
