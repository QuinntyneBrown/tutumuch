@startuml
title UML sequence behaviour — Open the sell form
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Seller" as actor
box "Frontend — @tutumuch/listings and @tutumuch/api" #E0F2FE
  participant "SellPage" as page
  participant "AuthState" as auth
  participant "SellingApi" as opts
end box
box "Backend — Tutu Much API application" #D1FADF
  participant "CategoriesController" as ctrl
end box
box "Backend — TutuMuch Application and Domain" #ECFDF3
  participant "CategoryCatalog" as catalog
end box
actor -> page : Open /sell
page -> auth : load() (GET /api/auth/me)
alt visitor
  page --> actor : Redirect to /sign-in?returnUrl=/sell
else email not verified
  page --> actor : "Verify your email to sell" with "Resend link" (unverified state)
else verified member may sell (L2-003)
  page -> opts : load()
  opts -> ctrl : GET /api/categories and GET /api/selling/options
  ctrl -> catalog : Read accepted categories, subcategories and sizes (L2-011)
  catalog --> ctrl : 4 categories, 12 subcategories
  alt API reachable
    ctrl --> opts : 200 categories; 200 feePercent, conditions, suggestedBrands
    opts --> page : Categories and options (cached for the session)
    page --> actor : Blank form with no size input (L2-012)
    actor -> page : Choose category "Dresses"
    page --> actor : tm-fixed-size "Size: Girls'" and the Dresses types
    actor -> page : Enter price and shipping
    page --> actor : "You earn after the 10% fee" estimate (L2-031)
  else 5xx or network failure
    ctrl --> opts : 500 problem details with correlation ID
    opts --> page : Failure (not cached)
    page --> actor : "Couldn't open the form" with Ref and "Try again" (L2-068)
  end
end
@enduml
