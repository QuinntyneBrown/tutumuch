@startuml
title UML sequence behaviour — Buyer asks to cancel and seller responds
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
skinparam maxMessageSize 260
actor "Buyer" as buyer
actor "Seller" as seller
box "Frontend — TuTuMuch Web application" #E0F2FE
  participant "RequestCancellationDialog" as rq
  participant "RespondCancellationDialog" as rs
  participant "OrdersApi (@tutumuch/api)" as client
end box
box "Backend — TuTuMuch API application (TuTuMuch.Api)" #D1FADF
  participant "OrdersController" as ctrl
end box
box "Backend — TuTuMuch.Application and TuTuMuch.Domain" #ECFDF3
  participant "RequestCancellationCommandHandler" as rh
  participant "RespondToCancellationCommandHandler" as sh
  participant "OrderCancellation" as ch
end box
box "Backend — TuTuMuch.Infrastructure" #FFF4E5
  database "TuTuMuch database" as db
end box
buyer -> rq : "Ask to cancel", optional message, "Send request"
rq -> client : requestCancellation(orderId, message)
client -> ctrl : POST /api/orders/{id}/cancellation-request
ctrl -> rh : RequestCancellationCommand
rh -> db : Load order where BuyerId = caller
alt order not Paid
  rh --> ctrl : 409 ORDER_INVALID_TRANSITION
else a request was already made
  rh --> ctrl : 409 CANCELLATION_ALREADY_REQUESTED
else Paid, no request yet
  rh -> db : Order request Pending with the message, enqueue CancellationRequested to seller (L2-035 criterion 2), one save
  ctrl --> client : 200 PurchaseDto
  rq --> buyer : Close; "You asked {seller} to cancel. They haven't answered yet."
end
seller -> rs : On sale "Buyer asked to cancel", choose "Respond"
alt "Accept and refund"
  rs -> client : respondToCancellation(orderId, Accept)
  client -> ctrl : POST /api/orders/{id}/cancellation-request/response
  ctrl -> sh : RespondToCancellationCommand(Accept)
  sh -> ch : CancelAsync(BuyerAskedToCancel, actor Seller)
  ch -> db : Paid to Cancelled, request Accepted, listing Removed, full refund, OrderCancelled email, one save; then refund issued
  ctrl --> rs : 200 SaleDto; sale shows "Cancelled" with "Relist item"
else "Decline"
  rs -> client : respondToCancellation(orderId, Decline)
  client -> ctrl : POST /api/orders/{id}/cancellation-request/response
  ctrl -> sh : RespondToCancellationCommand(Decline)
  sh -> db : Request Declined; order stays Paid; no email
  ctrl --> rs : 200 SaleDto; seller still ships by the ship-by date
end
@enduml
