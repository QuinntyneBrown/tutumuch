@startuml
title UML sequence behaviour — Payout release after completion
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
skinparam maxMessageSize 260
box "Backend — TutuMuch.Application and TutuMuch.Domain" #ECFDF3
  participant "OrderCompletedPayoutHandler" as evh
  participant "Payout" as payout
end box
box "Backend — Tutu Much Worker application (TutuMuch.Worker)" #D1FADF
  participant "PayoutReleaseJob / ReleasePayoutsHandler" as job
end box
box "Backend — TutuMuch.Infrastructure" #FFF4E5
  database "Tutu Much database" as db
end box
participant "Payment provider" as pay
box "Backend — Tutu Much API application (TutuMuch.Api)" #D1FADF
  participant "PayoutWebhookController" as wh
end box
== OrderCompleted published after the completion is saved (ADR orders/0004) ==
evh -> db : Load Payout by OrderId
evh -> payout : OrderCompleted(sellerOnboarded, now)
alt seller onboarding Complete
  payout -> payout : Releasable
else not Complete (L2-031 criterion 1)
  payout -> payout : Held, OnboardingIncomplete
end
evh -> db : Save
== Every Payouts:ReleaseJobInterval ==
job -> db : Catch up: Held/OrderNotCompleted payouts of Completed orders get OrderCompleted (lost event)
job -> db : SELECT payouts p JOIN orders o JOIN accounts a WHERE p.Status='Releasable' AND o.Status='Completed' AND a.Status='Complete'
note right of job : Paid, Shipped and Delivered orders never match (L2-031 criterion 3)
db --> job : Releasable payouts
loop each payout
  job -> pay : CreatePayoutAsync(accountId, NetAmount, idempotency key = Payout.Id)
  alt accepted
    pay --> job : ProviderPayoutId
    job -> payout : MarkSent(id, now)
    job -> db : Save
  else provider error
    pay --> job : Error
    job -> db : Keep Releasable, log, retry next run
  end
end
pay -> wh : payout.paid or payout.failed (Payout-Signature)
alt payout.paid
  wh -> db : Payout Paid, PaidAt
else payout.failed
  wh -> db : Payout Failed, FailureReason; banner "Your last payout was returned by the bank."
end
@enduml
