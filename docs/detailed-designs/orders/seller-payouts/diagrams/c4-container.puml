@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Seller payouts

Person(seller, "Seller", "Member")
System_Boundary(tutumuch, "TuTuMuch") {
  Container(web, "TuTuMuch Web", "Angular", "Payouts page, payout banner, sale detail payout panel")
  Container(api, "TuTuMuch API", "ASP.NET Core", "Payout queries, onboarding link, webhook")
  Container(worker, "TuTuMuch Worker", ".NET worker service", "PayoutReleaseJob")
  ContainerDb(db, "TuTuMuch database", "SQL Server", "Payouts, payout accounts, orders")
}
System_Ext(pay, "Payment provider", "Payouts")
Rel(seller, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, pay, "Creates onboarding links", "HTTPS")
Rel(pay, api, "Posts account and payout events", "Signed webhook")
Rel(worker, db, "Selects releasable payouts", "EF Core")
Rel(worker, pay, "Creates transfers", "HTTPS")
@enduml
