@startuml
title UML sequence behaviour — A new person joins with Google
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — @tutumuch/accounts and @tutumuch/api" #E0F2FE
  participant "GoogleJoinPage" as page
  participant "AuthState" as auth
end box
box "Backend — TuTuMuch API application" #D1FADF
  participant "GoogleSignInController" as ctrl
  participant "SessionCookies" as cookies
end box
box "Backend — TuTuMuch Application and Domain" #ECFDF3
  participant "GoogleCallbackCommandHandler" as cb
  participant "FinishGoogleJoinCommandHandler" as finish
  participant "MemberRegistrationRules" as rules
end box
box "Backend — TuTuMuch Infrastructure" #FFF4E5
  database "TuTuMuch database" as db
end box
actor -> ctrl : GET /api/auth/google/callback?state&code (after consent)
ctrl -> cb : GoogleCallbackCommand
cb -> db : No ExternalLogin, no member with the email
cb -> db : Insert PendingExternalJoin (google, sub, email, token hash, 10 min)
cb --> ctrl : JoinToken
ctrl --> actor : 302 to /join/google?returnUrl=…; tl_google_join (Strict, 10 min)
actor -> page : /join/google
page -> ctrl : GET /api/auth/google/pending (tl_google_join)
ctrl --> page : 200 { email } or 410 GOOGLE_JOIN_EXPIRED
page --> actor : "Almost there": email read-only, display name, 18+, terms
actor -> page : Display name, ticks, "Join TuTuMuch"
page -> auth : finishGoogleJoin(displayName, ageConfirmed, termsAccepted)
auth -> ctrl : POST /api/auth/google/finish (tl_google_join)
ctrl -> finish : FinishGoogleJoinCommand(token, displayName, age, terms)
finish -> db : Pending join by token hash; must be usable
finish -> rules : Display name format and uniqueness; age; terms (L2-001)
alt invalid
  finish --> ctrl : 422 GOOGLE_JOIN_INVALID with field errors
  ctrl --> page : 422
  page --> actor : Error summary and inline errors
else expired or used
  finish --> ctrl : 410 GOOGLE_JOIN_EXPIRED
  page --> actor : "That took a little too long"
else valid
  finish -> db : Insert Member (verified, no password), ExternalLogin; mark pending used; insert session
  finish --> ctrl : SignedIn
  ctrl -> cookies : Write tl_access and tl_refresh; clear tl_google_join
  ctrl --> auth : 200 member
  page --> actor : Navigate to returnUrl; top bar shows the member
end
@enduml
