@startuml
title UML sequence behaviour — Cancelled at Google or refused
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — @tutumuch/accounts" #E0F2FE
  participant "SignInPage" as page
end box
box "Backend — TuTuMuch API application" #D1FADF
  participant "GoogleSignInController" as ctrl
  participant "GoogleFlowCookie" as flow
end box
box "Backend — TuTuMuch Application" #ECFDF3
  participant "GoogleCallbackCommandHandler" as handler
  participant "IGoogleIdentityProvider" as port
end box
participant "Google" as google <<external>>
actor -> ctrl : GET /api/auth/google/start
ctrl --> actor : 302 to Google, tl_google_flow
actor -> google : "Cancel" on the consent page
google --> actor : 302 to callback?error=access_denied&state
actor -> ctrl : GET /api/auth/google/callback?error=access_denied&state
ctrl -> flow : Read and clear
ctrl --> actor : 302 to /sign-in?google=cancelled (no session)
page --> actor : "Google sign-in was cancelled" (status)
== Refused ==
actor -> ctrl : GET /api/auth/google/callback?state=other&code=…
ctrl -> flow : state does not match the cookie
ctrl --> actor : 302 to /sign-in?google=failed&ref=…
== Token refused ==
actor -> ctrl : GET /api/auth/google/callback?state&code
ctrl -> handler : GoogleCallbackCommand
handler -> port : ExchangeCodeAsync
port -> google : Token endpoint
port --> handler : null (code refused, forged, expired or wrong-audience token) or email_verified=false or nonce mismatch
handler --> ctrl : 401 GOOGLE_SIGN_IN_FAILED or 403 GOOGLE_EMAIL_UNVERIFIED
ctrl --> actor : 302 to /sign-in?google=failed&ref=…; nothing stored
page --> actor : "Couldn’t sign in with Google" with the reference
@enduml
