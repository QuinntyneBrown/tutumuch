@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Search and filter the catalog

Person(visitor, "Visitor or member", "Narrows the catalog")
Container_Boundary(web, "Tutu Much Web") {
  Component(topbar, "TopBarComponent + AppShell", "@tutumuch/components, tutumuch", "Search form, cuts to 100 characters, navigates to /?q=")
  Component(form, "FilterForm", "@tutumuch/catalog component", "Category, subcategory, brand, condition, price")
  Component(sidebar, "FiltersSidebar", "@tutumuch/catalog component", "Permanent sidebar from 992 px")
  Component(sheet, "FiltersSheet", "@tutumuch/catalog, tm-sheet via SheetService", "Full screen under 768 px, side panel 768-991 px")
  Component(page, "CatalogPage + CatalogStore", "@tutumuch/catalog route component", "Parses URL, header, chips, sort, no-results")
  Component(query, "catalog-query.ts", "TypeScript functions", "URL <-> CatalogQuery")
  Component(client, "CatalogApi", "@tutumuch/api", "Listings, count, brands")
}
Container_Boundary(api, "Tutu Much API") {
  Component(ctrl, "CatalogController", "ASP.NET Core controller", "Catalog read endpoints")
  Component(criteria, "CatalogCriteria", "Application record", "Validates filters, Apply and Order")
  Component(browse_h, "BrowseCatalogQueryHandler", "MediatR handler", "Ranked, sorted page")
  Component(count_h, "CountCatalogListingsQueryHandler", "MediatR handler", "Live result count")
  Component(brand_h, "GetCatalogBrandsQueryHandler", "MediatR handler", "Brand list")
  Component(ctx, "ITutuMuchDbContext", "EF Core port", "Listings")
}
ContainerDb(db, "Tutu Much database", "SQL Server", "Listings")

Rel(visitor, topbar, "Types keyword")
Rel(visitor, sheet, "Edits filters")
Rel(sidebar, form, "Hosts")
Rel(sheet, form, "Hosts")
Rel(page, query, "Parses and writes URL with")
Rel(page, sidebar, "Navigates on apply")
Rel(page, sheet, "Opens, navigates with result")
Rel(page, client, "Requests results and brands")
Rel(sheet, client, "Requests live count")
Rel(client, ctrl, "GET /api/catalog/...", "JSON/HTTPS")
Rel(ctrl, browse_h, "BrowseCatalogQuery")
Rel(ctrl, count_h, "CountCatalogListingsQuery")
Rel(ctrl, brand_h, "GetCatalogBrandsQuery")
Rel(browse_h, criteria, "From, Apply, Order")
Rel(count_h, criteria, "From, Apply")
Rel(browse_h, ctx, "Queries")
Rel(count_h, ctx, "Counts")
Rel(brand_h, ctx, "Groups by brand")
Rel(ctx, db, "LIKE, IN and range filters", "EF Core")
@enduml
