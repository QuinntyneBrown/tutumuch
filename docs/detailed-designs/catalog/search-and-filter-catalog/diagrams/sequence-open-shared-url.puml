@startuml
title UML sequence behaviour — Open a shared result-set URL
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Visitor in a new browser" as actor
box "Frontend — TuTuMuch Web application" #E0F2FE
  participant "CatalogPage" as page
  participant "catalog-query.ts" as codec
  participant "CatalogStore" as store
  participant "CatalogApi" as client
end box
box "Backend — TuTuMuch API application" #D1FADF
  participant "CatalogController" as controller
end box
box "Backend — TuTuMuch Application" #ECFDF3
  participant "BrowseCatalogQueryHandler" as handler
end box
box "Backend — TuTuMuch Infrastructure" #FFF4E5
  database "TuTuMuch database" as db
end box
actor -> page : Open /?category=dresses&condition=new-with-tags&min=20&max=200&sort=price-asc
page -> client : brands()
client --> page : Brand list for the filter form
page -> codec : parseQuery(queryParamMap)
codec --> page : CatalogQuery without unknown values
page -> codec : canonicalParams(params, query)
alt URL holds unknown values or a different order
  codec --> page : Canonical parameters
  page -> page : router.navigate(canonical params, replaceUrl: true)
else URL is canonical
  codec --> page : null
end
page -> page : Sidebar, chips and sort select read the query
page -> store : load(toParams(query))
store -> client : listings(1, params)
client -> controller : GET /api/catalog/listings?category=dresses&condition=new-with-tags&min=20&max=200&sort=price-asc
controller -> handler : Send BrowseCatalogQuery
handler -> db : Same filters, ORDER BY Price ASC, Id DESC
db --> handler : Same rows as the sharer saw
handler --> controller : CatalogPageDto
controller --> client : 200 OK
client --> store : CatalogPageDto
store --> page : loaded
page --> actor : Same filters, sort and results (L2-024)
@enduml
