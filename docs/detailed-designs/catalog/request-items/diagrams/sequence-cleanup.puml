@startuml
title UML sequence behaviour — Clean up expired item requests
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — TuTuMuch Worker application" #D1FADF
  participant "ItemRequestCleanupJob" as job
end box
box "Backend — TuTuMuch Application and Domain" #ECFDF3
  participant "CleanUpItemRequestsHandler" as handler
end box
box "Backend — TuTuMuch Infrastructure" #FFF4E5
  database "TuTuMuch database" as db
end box
job -> job : Run daily (ItemRequests:Cleanup:Interval)
job -> handler : CleanUpItemRequestsCommand
handler -> db : Select requests with ExpiresAt <= now - 30 days (L2-098)
db --> handler : Long-expired requests
handler -> db : Delete them; their ItemRequestMatches cascade
handler --> job : Number deleted
@enduml
